# A WebKit build with a minimal X desktop, reachable from any browser over noVNC.
#
# Why this exists next to the native launcher, and why only for WebKit: Playwright
# deletes old builds and, for older OS releases, pins a different revision - so a
# WebKit build can still exist for Linux while no macOS archive of it was ever
# published. Measured: r1860 (WebKit 16.4) is still served as
# webkit-ubuntu-22.04.zip and has no mac counterpart at all. A container is the
# only way a Mac reaches those versions.
#
# Chromium has its own image (Dockerfile) because it needs none of the fifty-six
# packages below and does need a libgconf shim that WebKit has no use for.
# Firefox and Edge have no image: their native downloads work on every platform
# this tool runs on, so a container would add a gigabyte and buy nothing.

# The base and the archive are one decision, not two. A build named
# webkit-ubuntu-22.04.zip is linked against that release: drop it on Debian 12 and
# it dies at exec with
#     libicudata.so.70: cannot open shared object file
# Playwright names these archives by distro precisely because they do not travel.
# The same lesson, arriving from the other side: the 20.04 archive in a 22.04
# image builds cleanly and then dies with "libvpx.so.6: cannot open shared object
# file", because jammy carries libvpx7.
#
# So one knob sets both, and a mismatched pair cannot be expressed. It has to be a
# knob because which releases a revision was published for is not a rule. It was
# written here as one - everything below r1724 is focal, everything above is
# jammy - and measured against the CDN one revision at a time, that is wrong in
# three separate ways:
#
#   r1668, r1715           no Linux build at all, on any release
#   r1908                  20.04 only, in the middle of the jammy range
#   r1751, r1944, r1992    22.04 only, where their neighbours have both
#
# Which is why the launchers ask the CDN rather than consulting a boundary; see
# webkit_ubuntu() in engineshelf-docker.sh and Get-WebKitUbuntu in
# engineshelf-docker.ps1. The catalog carries the same answer as an S-row field,
# so the page can grey out a row nothing can build before it is pressed.
ARG UBUNTU=22.04
FROM --platform=linux/amd64 ubuntu:${UBUNTU}

ARG REVISION=2336
# Repeated with its default: an ARG from before FROM is out of scope inside the
# stage, and re-declaring it bare would leave it empty on a build with no
# --build-arg.
ARG UBUNTU=22.04

ENV DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:0 \
    SCREEN=1440x900x24 \
    ENGINE=webkit

# The desktop, and nothing the browser needs. This layer is the same bytes for
# every revision on a given base, so it is the one Docker gets to reuse; what the
# build itself links against is per-revision and comes further down, after the
# archive that names it.
RUN set -eu; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates wget unzip \
        xvfb x11vnc fluxbox novnc websockify \
        autocutsel xclip; \
    rm -rf /var/lib/apt/lists/*

# Kept in the environment so the container can say which build it is running.
ENV REVISION=${REVISION}

# The archive for the distro this image is, and no other - see the note above
# FROM. Not a search: a build that downloads cleanly and then cannot resolve its
# libraries is worse than one that stops here saying which release is missing.
RUN set -eu; \
    url="https://cdn.playwright.dev/dbazure/download/playwright/builds/webkit/${REVISION}/webkit-ubuntu-${UBUNTU}.zip"; \
    if ! wget -q -O /tmp/webkit.zip "$url"; then \
        echo "No Ubuntu ${UBUNTU} build of WebKit r${REVISION} is published." >&2; \
        echo "  $url" >&2; \
        echo "  Playwright publishes each revision for some releases and not others;" >&2; \
        echo "  a few - r1668, r1715 - it never published for Linux at all." >&2; \
        exit 1; \
    fi; \
    echo "webkit r${REVISION}: webkit-ubuntu-${UBUNTU}.zip"; \
    mkdir -p /opt/webkit; \
    unzip -q /tmp/webkit.zip -d /opt/webkit; \
    rm /tmp/webkit.zip; \
    chmod +x /opt/webkit/pw_run.sh; \
    find /opt/webkit -type f -name 'MiniBrowser*' -exec chmod +x {} \; ; \
    test -x /opt/webkit/pw_run.sh

# What this particular build links against, read off the build itself rather than
# written down here. See the file: it also refuses to finish an image whose
# browser could not start.
COPY webkit-deps.sh /tmp/webkit-deps.sh
RUN sh /tmp/webkit-deps.sh && rm /tmp/webkit-deps.sh

COPY clipboard.js /usr/share/novnc/app/clipboard.js
COPY novnc-clipboard.sh /tmp/novnc-clipboard.sh
RUN sh /tmp/novnc-clipboard.sh && rm /tmp/novnc-clipboard.sh

# websockify plus one response header. Without it the desktop's own files are
# cached by the browser for years against a shared http://localhost:6080, and a
# rebuilt image links its new ui.js against somebody else's cached core/.
COPY novnc-serve.py /usr/local/bin/novnc-serve
RUN chmod +x /usr/local/bin/novnc-serve

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 6080 5900
VOLUME /data

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
